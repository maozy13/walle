{
  "name": "walle",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "walle": "./bin/walle.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:neuralink": "tsc -p node_modules/neuralink/tsconfig.json",
    "postinstall": "pnpm build:neuralink",
    "build": "pnpm build:neuralink && tsc -p tsconfig.json",
    "demo": "pnpm build && tsc -p demo/tsconfig.json && node dist/demo/responses-api.js",
    "demo:agent": "pnpm build && tsc -p demo/tsconfig.json && node dist/demo/agent.js",
    "test": "pnpm build:neuralink && vitest run --coverage",
    "typecheck": "pnpm build && tsc --noEmit -p demo/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "neuralink": "github:maozy13/neuralink",
    "zod": "^4.5.4"
  }
}
